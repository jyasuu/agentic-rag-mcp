# agentic-rag MCP server — full environment template.
# Copy to .env / export, then run the example scripts.
# See examples/reference.md for details.

# --- required ---
# Bearer token every MCP request must present.
RAG_MCP_AUTH_TOKEN=dev-secret
# Postgres URL (pgvector image: user/pass/db all "rag").
RAG_MCP_DATABASE_URL=postgres://rag:rag@127.0.0.1:5432/rag

# --- server ---
# Socket the HTTP server binds.
RAG_MCP_BIND_ADDR=127.0.0.1:8080
# Startup connect/health-check timeout, seconds.
RAG_MCP_CONNECT_TIMEOUT_SECS=5

# --- elasticsearch ---
RAG_MCP_ELASTICSEARCH_URL=http://127.0.0.1:9200
RAG_MCP_ES_INDEX=documents

# --- embeddings ---
# Pick ONE backend. Remote Ollama takes priority over the local ONNX dir.
# (1) Remote Ollama — model must output embedding_length = 1024 (e.g. bge-m3).
RAG_MCP_OLLAMA_URL=http://127.0.0.1:11434
RAG_MCP_OLLAMA_MODEL=bge-m3
# (2) Local ONNX — directory with model_int8.onnx (or model.onnx) + tokenizer.json.
#RAG_MCP_EMBEDDING_MODEL_DIR=/path/to/bge-m3-onnx
#ORT_DYLIB_PATH=/path/to/libonnxruntime.so
